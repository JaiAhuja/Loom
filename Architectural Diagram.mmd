---
title: Loom — Full Architecture
---
flowchart TB
    %% ─────────────────────────────────────────
    %% EXTERNAL SERVICES
    %% ─────────────────────────────────────────
    subgraph EXT["☁️ External Services"]
        direction LR
        OLLAMA["🦙 Ollama<br/><i>localhost:11434</i><br/>LLM inference &amp; embeddings"]
        NEO4J["🔵 Neo4j Desktop<br/><i>bolt://127.0.0.1:7687</i><br/>Knowledge graph DB"]
        CHROMADB["🟢 ChromaDB<br/><i>./data/chroma_db</i><br/>Vector store"]
        LANGSMITH["📊 LangSmith<br/><i>Optional tracing</i>"]
    end

    %% ─────────────────────────────────────────
    %% UI LAYER
    %% ─────────────────────────────────────────
    subgraph UI["🖥️ Streamlit UI Layer"]
        direction LR
        APP["<b>app.py</b><br/>Streamlit multipage router"]
        CHATPAGE["<b>pages/1_Chat.py</b><br/>Chat page<br/>• Sidebar toggles<br/>• PDF upload<br/>• Agent invocation<br/>• Auto-save responses"]
        KGPAGE["<b>pages/2_Knowledge_Graph.py</b><br/>KG Explorer page<br/>• Graph View (pyvis)<br/>• Paper/detail inspector<br/>• Concept Explorer<br/>• Cross-Paper Relations"]
        HISTORYPAGE["<b>pages/3_Chat_History.py</b><br/>Saved chat viewer"]
        APP --> CHATPAGE
        APP --> KGPAGE
        APP --> HISTORYPAGE
    end

    %% ─────────────────────────────────────────
    %% CONFIG
    %% ─────────────────────────────────────────
    subgraph CFG["⚙️ Configuration"]
        SETTINGS["<b>config/settings.py</b><br/>Settings (Pydantic)<br/>• Ollama params (incl. OLLAMA_NUM_CTX)<br/>• Neo4j creds<br/>• ChromaDB path<br/>• RAG tuning knobs<br/>• LangSmith config"]
    end

    %% ─────────────────────────────────────────
    %% INGESTION PIPELINE
    %% ─────────────────────────────────────────
    subgraph INGEST["📥 Ingestion Pipeline"]
        direction TB
        IDENTITY["<b>ingestion/identity.py</b><br/>DocumentIdentity<br/>• Filename-based doc_id<br/>• MD5 hash for storage path<br/>• UUID ingest_id per session"]
        INGSVC["<b>ingestion/service.py</b><br/>IngestionService<br/>• Orchestrates full pipeline<br/>• RAG skip by document_id<br/>• KG catch-up for missing details<br/>• Profile sidecar save/load<br/>• Progress callbacks"]
    end

    %% ─────────────────────────────────────────
    %% RAG PIPELINE
    %% ─────────────────────────────────────────
    subgraph RAG["📄 RAG Pipeline"]
        direction TB
        PROCESSOR["<b>rag/processor.py</b><br/>DocumentProcessor<br/>• PDF → Markdown (Docling)<br/>• Hybrid chunking<br/>• PaperProfile extraction<br/>• Summary chunk creation<br/>• Deterministic chunk IDs"]
        STORE["<b>rag/store.py</b><br/>VectorStoreManager<br/>• Upsert with dedup IDs<br/>• Filtered retrieval<br/>• Collection management<br/>• Paper listing"]
    end

    %% ─────────────────────────────────────────
    %% LLM PROVIDER
    %% ─────────────────────────────────────────
    subgraph LLM["🧠 LLM Provider"]
        PROVIDER["<b>llm/provider.py</b><br/>get_llm() → ChatOllama<br/>get_embeddings() → OllamaEmbeddings<br/>• Cached by model+temp"]
        PAPERPROFILE["<b>llm/paper_profile.py</b><br/>PaperProfile + extract_paper_profile()<br/>• Single ChatPromptTemplate call<br/>• Extracts summary, details,<br/>&nbsp;&nbsp;concepts, methods, findings"]
    end

    %% ─────────────────────────────────────────
    %% KNOWLEDGE GRAPH LAYER
    %% ─────────────────────────────────────────
    subgraph KG["🔗 Knowledge Graph Layer"]
        direction TB
        CONN["<b>services/knowledge_graph/connection.py</b><br/>Neo4jConnection<br/>• Lazy driver init<br/>• execute_read()<br/>• execute_write()<br/>• execute_write_tx()"]
        SCHEMA["<b>services/knowledge_graph/schema.py</b><br/>Schema constants<br/>• Node labels: Paper, PaperDetail,<br/>  Concept, Method, Finding, Author<br/>• Rel types: HAS_DETAIL, DISCUSSES,<br/>  SUPPORTS, CONTRADICTS, etc.<br/>• stable node keys + allow-lists<br/>• initialize_schema()"]
        QUERIES["<b>services/knowledge_graph/queries.py</b><br/>KnowledgeGraphQueries<br/>• get_all_papers()<br/>• get_paper_details()<br/>• get_shared_concepts()<br/>• get_graph_stats()<br/>• get_graph_for_visualization()<br/>• Contradiction/support/extend queries"]
        SERVICE["<b>services/knowledge_graph/service.py</b><br/>GraphQueryService<br/>• 9 named intents<br/>• Parameter validation<br/>• No free-form Cypher"]
        WRITER["<b>services/knowledge_graph/writer.py</b><br/>KnowledgeGraphWriter<br/>• write_paper_profile()<br/>• Writes PaperDetail child nodes<br/>• link_findings() — cross-finding edges<br/>• link_concepts() — cross-concept edges<br/>• Atomic detail/finding rewrites<br/>• UNWIND batch for concepts &amp; methods"]
    end

    %% ─────────────────────────────────────────
    %% LANGGRAPH AGENT
    %% ─────────────────────────────────────────
    subgraph AGENT["🤖 LangGraph Agent"]
        direction TB
        STATE["<b>graph/state.py</b><br/>AgentState<br/>• messages list<br/>• add_messages reducer"]
        NODES["<b>graph/nodes.py</b><br/>Agent node &amp; routing<br/>• build_system_prompt()<br/>• create_agent_node()<br/>• should_continue()<br/>• Conditional tool prompts"]
        BUILDER["<b>graph/builder.py</b><br/>GraphBuilder<br/>• Dynamic tool assembly<br/>• ReAct agent loop<br/>• Feature-flag gating<br/>• Compiles StateGraph"]
    end

    %% ─────────────────────────────────────────
    %% TOOLS
    %% ─────────────────────────────────────────
    subgraph TOOLS["🔧 Agent Tools"]
        direction LR
        RAGTOOL["<b>tools/rag_tool.py</b><br/>query_documents<br/>• Collection-bound retriever<br/>• Optional paper filter<br/>• Top-K chunk formatting"]
        SAFEGRAPH["<b>tools/safe_graph_tool.py</b><br/>query_knowledge_graph<br/>• Intent-based dispatch<br/>• JSON param parsing<br/>• Human-readable formatting"]
    end

    %% ─────────────────────────────────────────
    %% UTILITIES
    %% ─────────────────────────────────────────
    subgraph UTIL["🛠️ Utilities & UI"]
        CHATSTORE["<b>chat/store.py</b><br/>ChatStore<br/>• Save/load/search JSON chats<br/>• Resume conversations<br/>• Topic extraction"]
        EVALUATION["<b>evaluation/judge.py</b><br/>RAGJudge<br/>• LLM-as-a-Judge scoring<br/>• Context relevance (0-5)<br/>• Faithfulness (0-5)<br/>• Answer relevance (0-5)"]
        JSONPARSER["<b>utils/json_parser.py</b><br/>parse_llm_json()<br/>• Extract JSON from LLM output<br/>• Handles code-block wrapping"]
        UIMOD["<b>ui/bootstrap.py / chrome.py</b><br/>• Cached status checks (Ollama, Neo4j)<br/>• Shared HTML snippets<br/>• Destructive-action confirm"]
    end

    %% ═══════════════════════════════════════
    %% CONNECTIONS
    %% ═══════════════════════════════════════

    %% UI → Ingestion
    APP -->|"PDF upload"| INGSVC
    INGSVC --> IDENTITY
    INGSVC -->|"process PDF"| PROCESSOR
    INGSVC -->|"store chunks"| STORE
    INGSVC -->|"write KG + link relationships"| WRITER
    WRITER --> CONN

    %% UI → Agent
    APP -->|"user question"| BUILDER
    BUILDER --> NODES
    BUILDER --> STATE
    NODES -->|"bind tools + invoke LLM"| PROVIDER

    %% Agent ↔ Tools
    BUILDER -->|"assemble tools"| RAGTOOL
    BUILDER -->|"assemble tools"| SAFEGRAPH

    %% Tools → backends
    RAGTOOL -->|"retrieve chunks"| STORE
    SAFEGRAPH -->|"dispatch intent"| SERVICE
    SERVICE --> QUERIES
    QUERIES --> CONN

    %% KG page → queries
    KGPAGE -->|"read-only queries"| QUERIES

    %% RAG internals
    PROCESSOR -->|"extract paper profile"| PAPERPROFILE
    PAPERPROFILE -->|"LLM call"| PROVIDER
    STORE -->|"embed chunks"| PROVIDER

    %% KG internals
    SCHEMA -->|"create constraints"| CONN

    %% External service connections
    PROVIDER -->|"inference + embeddings"| OLLAMA
    CONN -->|"Bolt protocol"| NEO4J
    STORE -->|"persist vectors"| CHROMADB

    %% Config
    SETTINGS -.->|"settings singleton"| APP
    SETTINGS -.->|"settings singleton"| PROVIDER
    SETTINGS -.->|"settings singleton"| STORE
    SETTINGS -.->|"settings singleton"| CONN

    %% Utils
    APP -->|"save/load chat history"| CHATSTORE
    APP -->|"RAG quality scoring"| EVALUATION
    EVALUATION -->|"LLM judge call"| PROVIDER
    APP -->|"UI helpers"| UIMOD
    PROCESSOR -->|"parse LLM JSON"| JSONPARSER

    %% LangSmith
    SETTINGS -.->|"optional tracing"| LANGSMITH

    %% ═══════════════════════════════════════
    %% STYLING
    %% ═══════════════════════════════════════
    classDef extService fill:#2d2d2d,stroke:#888,color:#fff
    classDef uiNode fill:#1a73e8,stroke:#1557b0,color:#fff
    classDef cfgNode fill:#6d4c41,stroke:#4e342e,color:#fff
    classDef ingestNode fill:#e65100,stroke:#bf360c,color:#fff
    classDef ragNode fill:#2e7d32,stroke:#1b5e20,color:#fff
    classDef llmNode fill:#7b1fa2,stroke:#4a148c,color:#fff
    classDef kgNode fill:#0277bd,stroke:#01579b,color:#fff
    classDef agentNode fill:#c62828,stroke:#b71c1c,color:#fff
    classDef toolNode fill:#f9a825,stroke:#f57f17,color:#000
    classDef utilNode fill:#546e7a,stroke:#37474f,color:#fff
    classDef llmNode fill:#7b1fa2,stroke:#4a148c,color:#fff

    class OLLAMA,NEO4J,CHROMADB,LANGSMITH extService
    class APP,KGPAGE uiNode
    class SETTINGS cfgNode
    class IDENTITY,INGSVC ingestNode
    class PROCESSOR,STORE ragNode
    class PROVIDER,PAPERPROFILE llmNode
    class CONN,SCHEMA,QUERIES,SERVICE,WRITER kgNode
    class STATE,NODES,BUILDER agentNode
    class RAGTOOL,SAFEGRAPH toolNode
    class CHATSTORE,EVALUATION,JSONPARSER,UIMOD utilNode
