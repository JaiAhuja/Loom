# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
.venv/
env/
ENV/

# Environment Variables
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data (keep structure, ignore content)
data/chat_history/*
data/chroma_db/*
data/pdfs/*
data/txt/*
!data/chat_history/.gitkeep
!data/chroma_db/.gitkeep
!data/pdfs/.gitkeep
!data/txt/.gitkeep

# Outputs (keep structure, ignore content)
outputs/*.md
!outputs/.gitkeep

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Misc
*.log
*.tmp
